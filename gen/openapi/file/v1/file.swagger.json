{
  "swagger": "2.0",
  "info": {
    "title": "File Service API",
    "description": "Service for uploading files to object storage and returning permanent URLs",
    "version": "0.0.1"
  },
  "tags": [
    {
      "name": "FileService"
    }
  ],
  "schemes": [
    "http",
    "https"
  ],
  "consumes": [
    "multipart/form-data"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/v1/files": {
      "post": {
        "summary": "Upload file and get permanent URL",
        "operationId": "FileService_UploadFile",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1UploadFileResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "file",
            "in": "formData",
            "required": true,
            "type": "file"
          }
        ],
        "tags": [
          "FileService"
        ],
        "consumes": [
          "multipart/form-data"
        ],
        "produces": [
          "application/json"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
  "definitions": {
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1UploadFileRequest": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "format": "binary",
          "description": "File to upload"
        }
      }
    },
    "v1UploadFileResponse": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "Permanent URL of the stored file."
        },
        "size": {
          "type": "string",
          "format": "uint64",
          "description": "Size of the stored file in bytes."
        },
        "mimeType": {
          "type": "string",
          "description": "MIME type detected by the service."
        }
      }
    }
  },
  "securityDefinitions": {
    "BearerAuth": {
      "type": "apiKey",
      "description": "JWT Bearer token",
      "name": "Authorization",
      "in": "header"
    }
  }
}
